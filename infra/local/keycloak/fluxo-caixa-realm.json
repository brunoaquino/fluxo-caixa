{
  "realm": "fluxo-caixa",
  "displayName": "Fluxo de Caixa",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "passwordPolicy": "length(8)",
  "attributes": {
    "userProfileEnabled": "true"
  },
  "clientScopes": [
    {
      "name": "lancamentos:write",
      "description": "Registrar e estornar lancamentos",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "lancamentos:read",
      "description": "Consultar lancamentos",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "consolidado:read",
      "description": "Consultar o saldo consolidado",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "comerciante-id",
      "description": "Claim comerciante_id no access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "comerciante_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "comerciante_id",
            "claim.name": "comerciante_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "fluxo-caixa-app",
      "name": "Fluxo de Caixa",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "lancamentos:write",
        "lancamentos:read",
        "consolidado:read",
        "comerciante-id"
      ],
      "protocolMappers": [
        {
          "name": "comerciante_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "comerciante_id",
            "claim.name": "comerciante_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "comerciante1",
      "enabled": true,
      "email": "comerciante1@localhost",
      "emailVerified": true,
      "firstName": "Comerciante",
      "lastName": "Um",
      "credentials": [
        {
          "type": "password",
          "value": "comerciante1",
          "temporary": false
        }
      ],
      "attributes": {
        "comerciante_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      }
    },
    {
      "username": "comerciante2",
      "enabled": true,
      "email": "comerciante2@localhost",
      "emailVerified": true,
      "firstName": "Comerciante",
      "lastName": "Dois",
      "credentials": [
        {
          "type": "password",
          "value": "comerciante2",
          "temporary": false
        }
      ],
      "attributes": {
        "comerciante_id": [
          "22222222-2222-2222-2222-222222222222"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ENABLED\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${profile.firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${profile.lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"comerciante_id\",\"displayName\":\"ID do comerciante\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  }
}
