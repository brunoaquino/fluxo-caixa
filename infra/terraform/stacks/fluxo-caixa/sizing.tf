    api_stage_burst_limit             = coalesce(var.sizing.api_stage_burst_limit, local.selected.api_stage_burst_limit)
    api_consolidado_rate_limit        = coalesce(var.sizing.api_consolidado_rate_limit, local.selected.api_consolidado_rate_limit)
    api_consolidado_burst_limit       = coalesce(var.sizing.api_consolidado_burst_limit, local.selected.api_consolidado_burst_limit)
