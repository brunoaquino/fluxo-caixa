    api_lancamentos_write_burst_limit = coalesce(var.sizing.api_lancamentos_write_burst_limit, local.selected.api_lancamentos_write_burst_limit)
    api_lancamentos_read_rate_limit   = coalesce(var.sizing.api_lancamentos_read_rate_limit, local.selected.api_lancamentos_read_rate_limit)
